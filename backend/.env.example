# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# Database Configuration (PostgreSQL / Supabase compatible)
DATABASE_URL=postgresql://commpark_admin:commpark_secure_pass@localhost:5432/commpark_db?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Storage Provider (local | s3 | supabase)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET_NAME=commpark-parking-photos
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
